# Variables que lee la librería (todas opcionales salvo las de GitHub si usas
# los comandos *-autopr / checker). Copia a .env; .env está en .gitignore.

# --- Repositorio del sitio donde se escriben los datos y se abren las PRs ---
GITHUB_OWNER=your-org
GITHUB_REPO=your-site-repo
GITHUB_TOKEN=your_github_token       # permisos mínimos: contents + pull requests del repo del sitio
REPO_PATH=/path/to/your-site-repo    # clon local del repo del sitio

# --- Podcast ---
RSS_FEED_URL=https://example.com/podcast/feed.xml
# RSS_REPOSITORY_PATH, RSS_MAIN_BRANCH, RSS_WORK_BRANCH, RSS_LOCK_PATH
# RSS_CHECK_WINDOWS / RSS_CHECK_TIMEZONE: ventanas horarias permitidas para el checker

# --- Redes sociales ---
SOCIAL_BSKY_PROFILES=alice.example.com,bob.example.com
SOCIAL_INSTAGRAM_PROFILES=your_profile   # solo si aportas un social.InstagramSource
# SOCIAL_REPOSITORY_PATH, SOCIAL_MAIN_BRANCH, SOCIAL_WORK_BRANCH, SOCIAL_LOCK_PATH
